#!/usr/bin/env bash
# Keyless GCP, AWS and tailnet access for a Cursor Cloud Agent VM of any
# repository, on Cursor's default image or a custom one. browserctrl's own
# environment (.cursor/) does the same through its Dockerfile, install.sh and
# start.sh; other repositories get this kit through .agents/sync-kit.
#
#   agent-access install  Build step, cached in the environment snapshot:
#                         installs jq, gcloud, aws and tailscale when missing,
#                         links the helpers into /usr/local/bin and sets the
#                         shell environment gcloud and aws need.
#   agent-access start    Every boot: saves the resource names, writes the
#                         coding-agents gcloud configuration and AWS profile,
#                         and keeps the VM on the tailnet in the background.
#
# Never fails the environment: a step that does not work is reported and
# skipped, so the repository's own setup still runs.
set -uo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(dirname "$self")"
conf_dir="$HOME/.config/coding-agents"

log() { echo "agent-access: $*"; }

# Keep the resource names where helpers started without the Cursor secrets in
# their environment (sudo, detached watchers) still find them. Only the
# AGENT_ENV_CONF secret is saved; a committed agent-env.conf is read in place.
save_conf() {
  [ -f "$here/../agent-env.conf" ] && return 0
  if [ -n "${AGENT_ENV_CONF:-}" ]; then
    mkdir -p "$conf_dir" &&
      printf '%s\n' "$AGENT_ENV_CONF" >"$conf_dir/agent-env.conf.tmp" &&
      mv "$conf_dir/agent-env.conf.tmp" "$conf_dir/agent-env.conf"
  elif [ ! -f "$conf_dir/agent-env.conf" ]; then
    log "no AGENT_ENV_CONF secret and no .agents/agent-env.conf; cloud and tailnet access stay off"
  fi
}

# Add an apt repository once. Keys that are already binary (Tailscale's
# .noarmor.gpg) are saved as they are; armored ones are dearmored.
apt_repo() { # name key-url key-file line
  [ -f "/etc/apt/sources.list.d/$1.list" ] && return 0
  case "$2" in
    *.noarmor.gpg) sudo curl -fsSL "$2" -o "$3" ;;
    *) curl -fsSL "$2" | sudo gpg --batch --yes --dearmor -o "$3" ;;
  esac && echo "$4" | sudo tee "/etc/apt/sources.list.d/$1.list" >/dev/null
}

install_tools() {
  local need=() codename
  command -v jq >/dev/null || need+=(jq)
  command -v unzip >/dev/null || need+=(unzip)
  command -v gpg >/dev/null || need+=(gnupg)
  command -v gcloud >/dev/null || need+=(google-cloud-cli)
  command -v tailscale >/dev/null || need+=(tailscale)
  if [ "${#need[@]}" -gt 0 ]; then
    codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"
    sudo install -d -m 0755 /etc/apt/keyrings
    command -v gpg >/dev/null || sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq gnupg
    if [[ " ${need[*]} " == *" google-cloud-cli "* ]]; then
      apt_repo google-cloud-sdk https://packages.cloud.google.com/apt/doc/apt-key.gpg /etc/apt/keyrings/cloud.google.gpg \
        "deb [signed-by=/etc/apt/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main"
    fi
    if [[ " ${need[*]} " == *" tailscale "* ]]; then
      apt_repo tailscale "https://pkgs.tailscale.com/stable/ubuntu/${codename}.noarmor.gpg" /etc/apt/keyrings/tailscale.gpg \
        "deb [signed-by=/etc/apt/keyrings/tailscale.gpg] https://pkgs.tailscale.com/stable/ubuntu ${codename} main"
    fi
    sudo apt-get update -qq &&
      sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "${need[@]}" ||
      { log "installing ${need[*]} failed"; return 1; }
    # Tailscale joins per session (agent-tailscale-up), never in the snapshot.
    sudo systemctl disable --now tailscaled >/dev/null 2>&1 || true
  fi
  if ! command -v aws >/dev/null; then
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSLo "$tmp/awscliv2.zip" "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" &&
      unzip -q "$tmp/awscliv2.zip" -d "$tmp" && sudo "$tmp/aws/install" ||
      { rm -rf "$tmp"; log "installing the AWS CLI failed"; return 1; }
    rm -rf "$tmp"
  fi
}

shell_env() {
  # Cursor resets PATH for agent shells, so the helpers go in /usr/local/bin,
  # and gcloud may run the executable token helper only with this variable.
  local f
  for f in "$here"/agent-*; do sudo ln -sf "$f" /usr/local/bin/; done
  printf '%s\n' \
    'export GOOGLE_EXTERNAL_ACCOUNT_ALLOW_EXECUTABLES=1' \
    'if [ -z "${AWS_PROFILE:-}" ] && grep -qE "^\[[[:space:]]*profile[[:space:]]+coding-agents[[:space:]]*\]" "${AWS_CONFIG_FILE:-$HOME/.aws/config}" 2>/dev/null; then export AWS_PROFILE=coding-agents; fi' |
    sudo tee /etc/profile.d/agent-cloud.sh >/dev/null
  grep -qF '/etc/profile.d/agent-cloud.sh' /etc/bash.bashrc 2>/dev/null ||
    echo '. /etc/profile.d/agent-cloud.sh' | sudo tee -a /etc/bash.bashrc >/dev/null
}

case "${1:-}" in
  install)
    save_conf
    install_tools || true
    shell_env || log "linking the helpers failed"
    export GOOGLE_EXTERNAL_ACCOUNT_ALLOW_EXECUTABLES=1
    timeout 60 "$here/agent-cloud-login" || log "agent-cloud-login failed; gcloud/aws stay unauthenticated"
    ;;
  start)
    save_conf
    # A snapshot from an older kit may lack the links.
    [ -e /usr/local/bin/agent-tailscale-up ] || shell_env || true
    export GOOGLE_EXTERNAL_ACCOUNT_ALLOW_EXECUTABLES=1
    timeout 60 "$here/agent-cloud-login" || log "agent-cloud-login failed; gcloud/aws may stay unauthenticated"
    "$here/agent-tailscale-up" --background || log "could not start the tailnet watcher"
    ;;
  *)
    echo "usage: agent-access install|start" >&2
    exit 2
    ;;
esac
exit 0
