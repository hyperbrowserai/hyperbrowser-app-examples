#!/usr/bin/env bash
# AWS credential_process helper: exchanges a short-lived platform OIDC token
# for temporary role credentials with AssumeRoleWithWebIdentity. The AWS CLI
# and SDKs call it on demand; nothing is written to disk.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
. "$here/../load-env.sh"
platform="$("$here/agent-platform")"

if [ -z "$AWS_ROLE_ARN" ]; then
  echo "agent-aws-credentials: AWS access is turned off (no AWS_ROLE_ARN; see .agents/load-env.sh)" >&2
  exit 1
fi

# The token goes to the AWS CLI through an owner-only tmpfs file, never on its
# command line.
tokenfile="$(mktemp -p /dev/shm)"
trap 'rm -f "$tokenfile"' EXIT
token="$("$here/agent-oidc-token" sts.amazonaws.com)"
printf '%s' "$token" >"$tokenfile"
unset token
# Unsigned call with an empty config and no profile selected, so this helper
# never recurses into itself and an inherited AWS_PROFILE (coding-agents)
# cannot point at a profile the empty config lacks.
env -u AWS_PROFILE -u AWS_DEFAULT_PROFILE \
  AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null AWS_EC2_METADATA_DISABLED=true \
  aws sts assume-role-with-web-identity --no-sign-request \
    --region "$AWS_REGION" \
    --role-arn "$AWS_ROLE_ARN" \
    --role-session-name "${platform}-$(hostname -s | cut -c1-40)" \
    --web-identity-token "file://$tokenfile" \
    --duration-seconds 3600 \
    --output json |
  jq '.Credentials | {Version: 1, AccessKeyId, SecretAccessKey, SessionToken, Expiration}'
