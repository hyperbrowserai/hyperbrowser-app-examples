HYPERBROWSER_API_KEY=your_hyperbrowser_api_key
HYPERBROWSER_TIMEOUT_MS=12000
# Comma-separated retry delays for active-session-limit errors.
HYPERBROWSER_SESSION_RETRY_DELAYS_MS=1500,3000,6000,12000

# Optional source-native connectors.
# GitHub can run unauthenticated with lower limits, but a token is recommended.
GITHUB_TOKEN=your_github_token

# Generic OpenAI-compatible provider. Use this for OpenRouter,
# NVIDIA NIM-style endpoints, or local-compatible gateways.
LLM_PROVIDER=nvidia
LLM_BASE_URL=your_openai_compatible_endpoint
LLM_API_KEY=your_provider_key
LLM_MODEL=your_model
LLM_SITE_URL=http://localhost:3000
LLM_APP_NAME=HyperGrowth
LLM_TIMEOUT_MS=12000
ENABLE_REASONING=false
REASONING_LEVEL=medium

# OpenAI fallback when LLM_API_KEY is not set.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Safety cap for LLM calls in full mode. Does not change the selected mode.
LLM_MAX_CALLS_PER_RUN=12
