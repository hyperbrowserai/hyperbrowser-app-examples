# Get a Hyperbrowser API key at https://hyperbrowser.ai
HYPERBROWSER_API_KEY=your_hyperbrowser_api_key
# Anthropic key with access to claude-opus-5
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Optional (defaults live in lib/config.ts) ───────────────────────────────
# Hard cap on generated-script execution, seconds (spec: 90).
# RUN_TIMEOUT_SECONDS=90
# Sandbox image with node + chromium + playwright-core preinstalled.
# SANDBOX_IMAGE=node-chromium
